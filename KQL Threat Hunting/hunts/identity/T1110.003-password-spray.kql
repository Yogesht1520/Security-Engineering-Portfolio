// Hunt: HB-ID-001 - Password Spray Against Multiple Accounts
// MITRE ATT&CK: T1110.003 (Password Spraying)
// Platform: Microsoft Sentinel (SigninLogs)
//
// Description: Detects a single IP address attempting passwords across multiple accounts,
// performing two-stage correlation with subsequent successful sign-ins across the targeted
// users to identify both failed spray probes and high-priority account compromises.

let lookback = 1d;
let window = 30m;
let minUsers = 10;
let followUpWindow = 2h;
let SprayFailures = SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in ("50126", "50053")
| summarize 
    FirstFailure = min(TimeGenerated),
    LastFailure = max(TimeGenerated),
    FailedUsers = dcount(UserPrincipalName),
    Attempts = count(),
    TargetUsers = make_set(UserPrincipalName, 50)
    by SprayIP = IPAddress, bin(TimeGenerated, window)
| where FailedUsers >= minUsers;
let SuccessLogins = SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType == "0"
| project SuccessTime = TimeGenerated, UserPrincipalName, SuccessIP = IPAddress, AppDisplayName, UserAgent;
SprayFailures
| mv-expand TargetUser = TargetUsers to typeof(string)
| join kind=leftouter (
    SuccessLogins
) on $left.TargetUser == $right.UserPrincipalName
| where isempty(SuccessTime) or (SuccessTime between (FirstFailure .. (LastFailure + followUpWindow)))
| summarize 
    FirstSpray = min(FirstFailure),
    LastSpray = max(LastFailure),
    SprayedAccounts = take_any(FailedUsers),
    TotalAttempts = take_any(Attempts),
    CompromisedAccounts = dcountif(TargetUser, isnotempty(SuccessTime)),
    SuccessfulUsers = make_set_if(TargetUser, isnotempty(SuccessTime), 10),
    SuccessIPs = make_set_if(SuccessIP, isnotempty(SuccessTime), 5),
    SuccessApps = make_set_if(AppDisplayName, isnotempty(SuccessTime), 5)
    by SprayIP, bin(TimeGenerated, window)
| extend CompromiseStatus = case(
    CompromisedAccounts > 0 and set_has_element(SuccessIPs, SprayIP), "Direct Compromise (Same IP)",
    CompromisedAccounts > 0, "Correlated Compromise (Different IP)",
    "Spray Probing Only (No Success)"
)
| project TimeGenerated, SprayIP, CompromiseStatus, SprayedAccounts, TotalAttempts, 
          CompromisedAccounts, SuccessfulUsers, SuccessIPs, SuccessApps, FirstSpray, LastSpray
| order by CompromisedAccounts desc, SprayedAccounts desc
