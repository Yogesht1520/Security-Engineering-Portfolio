// HB-ID-001 | T1110.003 | Password spray against multiple accounts from a single IP
// Hypothesis: An adversary attempts a small list of commonly used passwords across many accounts from one source IP to stay below per-account lockout thresholds.
let lookback = 1d;
let window = 30m;
let minUsers = 10;
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType == "50126"
| summarize
    FailedUsers = dcount(UserPrincipalName),
    Attempts = count(),
    SampleUsers = make_set(UserPrincipalName, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, window)
| where FailedUsers >= minUsers
| project
    TimeGenerated,
    IPAddress,
    FailedUsers,
    Attempts,
    SampleUsers,
    FirstSeen,
    LastSeen
| order by FailedUsers desc

