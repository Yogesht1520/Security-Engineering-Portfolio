{
  "name": "DeviceLogonEvents",
  "platform": "defender-xdr",
  "timeColumn": "Timestamp",
  "description": "Microsoft Defender for Endpoint host logon events",
  "columns": [
    { "name": "Timestamp", "type": "datetime", "description": "Timestamp when logon occurred" },
    { "name": "DeviceId", "type": "string", "description": "Unique identifier for the device" },
    { "name": "DeviceName", "type": "string", "description": "Hostname or FQDN of the device" },
    { "name": "ActionType", "type": "string", "description": "LogonSuccess, LogonFailed, etc." },
    { "name": "LogonType", "type": "string", "description": "Interactive, RemoteInteractive (RDP), Network, Batch, Service" },
    { "name": "AccountName", "type": "string", "description": "Account name attempting logon" },
    { "name": "AccountDomain", "type": "string", "description": "Domain of the account" },
    { "name": "RemoteIP", "type": "string", "description": "Source IP address of remote connection" },
    { "name": "RemoteDeviceName", "type": "string", "description": "Source device hostname" },
    { "name": "IsLocalAdmin", "type": "boolean", "description": "Whether the user had administrative privileges" }
  ]
}

