{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Yogesht1520/Security-Engineering-Portfolio/main/docs/schemas/threat_report_schema.json",
  "title": "ThreatReport",
  "description": "Schema for Automated Log Parser & Threat Report Generator JSON output",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "summary",
    "incidents",
    "top_offenders",
    "findings"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URI to the schema definition"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version of the threat report schema"
    },
    "title": {
      "type": "string",
      "description": "Title of the threat analysis report"
    },
    "summary": {
      "type": "object",
      "required": [
        "log_source",
        "generated_at",
        "total_lines",
        "parsed_lines",
        "malformed_lines",
        "duration_seconds",
        "lines_per_second",
        "total_findings",
        "total_incidents",
        "unique_attacker_ips",
        "unique_countries",
        "highest_severity",
        "parse_health_pct"
      ],
      "properties": {
        "log_source": { "type": "string" },
        "generated_at": { "type": "string" },
        "total_lines": { "type": "integer", "minimum": 0 },
        "parsed_lines": { "type": "integer", "minimum": 0 },
        "malformed_lines": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0.0 },
        "lines_per_second": { "type": "number", "minimum": 0.0 },
        "total_findings": { "type": "integer", "minimum": 0 },
        "total_incidents": { "type": "integer", "minimum": 0 },
        "unique_attacker_ips": { "type": "integer", "minimum": 0 },
        "unique_countries": { "type": "integer", "minimum": 0 },
        "total_attack_types": { "type": "integer", "minimum": 0 },
        "top_attack_type": { "type": "string" },
        "top_attack_count": { "type": "integer", "minimum": 0 },
        "highest_severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
        },
        "critical_high_count": { "type": "integer", "minimum": 0 },
        "parse_health_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "severity_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "attack_type_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "incident_id",
          "ip",
          "title",
          "severity",
          "finding_count",
          "attack_vectors",
          "start_time",
          "end_time"
        ],
        "properties": {
          "incident_id": { "type": "string" },
          "ip": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "finding_count": { "type": "integer", "minimum": 1 },
          "attack_vectors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mitre_tactics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "start_time": { "type": "string" },
          "end_time": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0.0 },
          "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "geo_country": { "type": ["string", "null"] },
          "geo_country_code": { "type": ["string", "null"] },
          "geo_city": { "type": ["string", "null"] },
          "rdns_hostname": { "type": ["string", "null"] },
          "asn_org": { "type": ["string", "null"] }
        }
      }
    },
    "top_offenders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ip",
          "country_name",
          "country_code",
          "flag_emoji",
          "city",
          "count",
          "top_attack_type",
          "highest_severity"
        ],
        "properties": {
          "ip": { "type": "string" },
          "country_name": { "type": "string" },
          "country_code": { "type": "string" },
          "flag_emoji": { "type": "string" },
          "city": { "type": "string" },
          "rdns_hostname": { "type": ["string", "null"] },
          "asn_org": { "type": ["string", "null"] },
          "count": { "type": "integer", "minimum": 1 },
          "top_attack_type": { "type": "string" },
          "highest_severity": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "attack_type",
          "timestamp",
          "description"
        ],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "attack_type": { "type": "string" },
          "ip": { "type": ["string", "null"] },
          "timestamp": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "evidence": { "type": ["string", "null"] },
          "geo_country": { "type": ["string", "null"] },
          "geo_country_code": { "type": ["string", "null"] },
          "geo_city": { "type": ["string", "null"] },
          "rdns_hostname": { "type": ["string", "null"] },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
