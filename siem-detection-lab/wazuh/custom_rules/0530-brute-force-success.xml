<group name="syslog,sshd,bruteforce,">
  <!--
    Custom Rule: SSH Brute-Force Success (Burst Correlation)
    Detects a successful SSH authentication that immediately follows a high-frequency
    burst brute-force attack from the same source IP.
    Maps to MITRE ATT&CK T1110.001 (Password Guessing) and T1078 (Valid Accounts).
  -->
  <rule id="100040" level="14" timeframe="600">
    <if_matched_sid>100010</if_matched_sid> <!-- Base rule: Burst brute-force detected -->
    <if_sid>5715</if_sid> <!-- Base rule: sshd authentication success -->
    <same_source_ip />
    <description>sshd: CRITICAL - Successful login following burst brute-force attack from $(srcip).</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,</group>
  </rule>

  <!--
    Custom Rule: SSH Brute-Force Success (Low-and-Slow Correlation)
    Detects a successful authentication after low-and-slow brute forcing from the same IP (within 1 hour).
  -->
  <rule id="100041" level="14" timeframe="3600">
    <if_matched_sid>100012</if_matched_sid> <!-- Base rule: Low-and-slow brute-force detected -->
    <if_sid>5715</if_sid> <!-- Base rule: sshd authentication success -->
    <same_source_ip />
    <description>sshd: CRITICAL - Successful login following low-and-slow brute-force attack from $(srcip).</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.4,pci_dss_10.2.5,pci_dss_11.4,</group>
  </rule>
</group>
