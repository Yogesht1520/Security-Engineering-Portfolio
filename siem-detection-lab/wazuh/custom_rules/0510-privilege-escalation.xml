<group name="syslog,privilege_escalation,">
  <!--
    Custom Rule: Privilege Escalation - New User Added
    Detects when a new user account is created.
    Maps to MITRE ATT&CK T1078 (Valid Accounts) / T1548 (Abuse Elevation Control Mechanism)
  -->
  <rule id="100020" level="8">
    <if_sid>5902</if_sid> <!-- Base rule: useradd command executed -->
    <description>System administration: New user account created.</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_creation,</group>
  </rule>

  <!--
    Custom Rule: Privilege Escalation - /etc/sudoers Modified
    Detects modifications to primary /etc/sudoers configuration file via FIM.
  -->
  <rule id="100021" level="12">
    <if_group>syscheck</if_group>
    <match>/etc/sudoers</match>
    <description>File integrity: Sudoers file (/etc/sudoers) modified - possible privilege escalation backdoor.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>sudoers_modification,syscheck,</group>
  </rule>

  <!--
    Custom Rule: Privilege Escalation - /etc/sudoers.d/ Directory Modified
    Detects persistence/backdoor additions in the /etc/sudoers.d/ drop-in directory.
  -->
  <rule id="100022" level="12">
    <if_group>syscheck</if_group>
    <match>/etc/sudoers.d/</match>
    <description>File integrity: Sudoers drop-in directory (/etc/sudoers.d/) modified - possible privilege escalation backdoor.</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
    <group>sudoers_modification,syscheck,</group>
  </rule>
</group>
