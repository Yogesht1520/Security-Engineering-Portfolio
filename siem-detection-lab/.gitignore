# =============================================================================
# .gitignore — SIEM Detection & Threat Engineering Lab
# Strict exclusions for confidential access data, credentials, AI plans & state
# =============================================================================

# ── 1. Confidential Lab Access & Operator Credentials ─────────────────────────
docs/LAB_ACCESS_DETAILS.md
*LAB_ACCESS_DETAILS.md
wazuh-passwords.txt
*password*.txt
*credentials*.txt
*secret*.txt

# ── 2. Agentic AI Instructions, Plans & Internal Artifacts ────────────────────
*PLAN*.md
*REMEDIATION*.md
*GAP_ANALYSIS*.md
*SCRATCHPAD*
scratch/
.agents/
AGENTS.md
GEMINI.md
.gemini/
.cursor/
.claude/
antigravity*
.system_generated/
prompt*.md
instructions*.md

# ── 3. Terraform — Infrastructure State & Populated Variables ─────────────────
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── 4. Cloud Service Accounts, Secrets & Cryptographic Keys ───────────────────
service-account-*.json
siem-detection-lab-*.json
*credential*.json
*secret*.json
*token*.json
*-sa-key.json
gcp-key*.json
*.pem
*.key
*.p12
*.pfx

# ── 5. SSH Private & Operator Keys ────────────────────────────────────────────
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
siem_lab_key
siem_lab_key.pub
*.key.pub

# ── 6. Python Bytecode, Caches & Virtual Environments ─────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
.env
.env.*
!*.env.example

# ── 7. OS, Editor & Temporary Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.bak
.vscode/
.idea/
*.exe