{
  "displayName": "CAP-005: Privileged Session Sign-in Frequency (8 Hours)",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "includeGroups": [
        "SEC-Admins",
        "SEC-Contractors"
      ]
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    }
  },
  "sessionControls": {
    "signInFrequency": {
      "value": 8,
      "type": "hours",
      "isEnabled": true
    },
    "persistentBrowser": {
      "mode": "never",
      "isEnabled": true
    }
  }
}
